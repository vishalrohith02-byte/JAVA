class TN
{
    static String CM="Vijay";
    static String Statename="TamilNadu";
    String dname;
    int p;
    public void set_dim(String m,int f)
    {
        dname=m;
        p=f;
    }
    public void display()
    {
        System.out.println("1.PM:"+PM.PM_name);
        System.out.println("2.State:"+Statename);
        System.out.println("3.CM:"+CM);
        System.out.println("4.District:"+dname);
        System.out.println("5.Population:"+p);
    }
    
}
