public class Main
{
    public static void main(String[] args)
    {
        String a = "vishalsankar";

        for(int i = 0; i < a.length(); i++)
        {
            boolean repeated = false;

            for(int j = 0; j < a.length(); j++)
            {
                if(i != j && a.charAt(i) == a.charAt(j))
                {
                    repeated = true;
                    break;
                }
            }

            if(!repeated)
            {
                System.out.println(a.charAt(i));
                return;
            }
        }
    }
}
