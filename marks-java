import java.util.Scanner;
class Student
{
    int a,b,c;
    String n;
    Student(String name,int m1,int m2,int m3)
    {
        n=name;
        a=m1;
        b=m2;
        c=m3;
    }
    public void display()
    {
        System.out.println("Percentage is :"+(a+b+c)/3+ "%");
    }
    
}
public class Main 
{
    public static void main(String[] args)
    {
        int m1,m2,m3;
        String name;
        Scanner a=new Scanner(System.in);
        System.out.println("Enter the number of Students");
        int n=a.nextInt();
        Student[] s=new Student[n];
        for(int i=0;i<n;i++)
        {
            System.out.println("Enter the name of the Student:"+(i+1));
            a.nextLine();
            name=a.nextLine();
            System.out.println("Enter the marks of the Student:"+(i+1));
            m1=a.nextInt();
            m2=a.nextInt();
            m3=a.nextInt();
            s[i]=new Student(name,m1,m2,m3);
        }
        System.out.println("Percentage of Students");
        for(int i=0;i<n;i++)
        {
            System.out.println("Percentage of Student"+(i+1));
            s[i].display();
        }
        
    }
}
