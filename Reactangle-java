import java.util.Scanner;
class Rect
{
    int c,d;
    Rect(int l,int b)
    {
        c=l;
        d=b;
    }
    public void display()
    {
        System.out.println("Area is :"+(c*d));
    }
    
}
public class Main 
{
    public static void main(String[] args)
    {
        int l,b;
        Scanner a=new Scanner(System.in);
        System.out.println("Enter the number of Rectangles");
        int n=a.nextInt();
        Rect[] r=new Rect[n];
        for(int i=0;i<n;i++)
        {
            System.out.println("Enter the length of the rectangle:"+(i+1));
            l=a.nextInt();
            System.out.println("Enter the breadth of the rectangle:"+(i+1));
            b=a.nextInt();
            r[i]=new Rect(l,b);
        }
        System.out.println("Area of rect");
        for(int i=0;i<n;i++)
        {
            System.out.println("Area of rect"+(i+1));
            r[i].display();
        }
        
    }
}
